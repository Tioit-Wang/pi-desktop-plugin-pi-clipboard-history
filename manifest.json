{
  "schemaVersion": 1,
  "id": "pi.clipboard-history",
  "name": "Clipboard History",
  "version": "0.1.0",
  "description": "Capture clipboard text while PI-Desktop runs, keep 30 days of history, restore any entry with one click.",
  "author": "Tioit-Wang",
  "main": "main.js",
  "ui": {
    "panel": "renderer/index.html",
    "title": { "en": "Clipboard History", "zh-CN": "剪贴板历史" },
    "width": 760,
    "height": 600
  },
  "contributes": {
    "commands": [
      {
        "id": "pi-clipboard-history.open",
        "title": "Clipboard History: Open Panel",
        "keywords": ["clipboard", "剪贴板", "history"]
      }
    ],
    "services": [
      { "id": "watcher", "label": "Clipboard watcher", "autoRestart": true }
    ]
  },
  "permissions": ["ui.panel", "clipboard.read", "clipboard.write", "background.service"],
  "engines": { "piDesktop": ">=0.8.0" },
  "activationEvents": ["onStartup", "onCommand:pi-clipboard-history.open"]
}
